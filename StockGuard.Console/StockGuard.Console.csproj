
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- CSVHelper package -->
  <ItemGroup>
    <PackageReference Include="CsvHelper" Version="34.1.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.*">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Copy inventory CSV files to the output folder -->
  <ItemGroup>
    <None Update="shopify.csv;warehouse.csv;shopify-export-sample.csv" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\StockGuard.Core\StockGuard.Core.csproj" />
    <ProjectReference Include="..\StockGuard.Infrastructure\StockGuard.Infrastructure.csproj" />
  </ItemGroup>

</Project>
